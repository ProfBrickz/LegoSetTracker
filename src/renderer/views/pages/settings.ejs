<h1>Settings</h1>

<section class="settings-section">
	<h4>Theme</h4>
	<p>Choose your preferred theme:</p>

	<div class="theme-buttons">
		<button id="theme-light" onclick="electronAPI.setTheme('light')">
			<i data-lucide="sun"></i>
			<span>Light</span>
		</button>
		<button id="theme-dark" onclick="electronAPI.setTheme('dark')">
			<i data-lucide="moon"></i>
			<span>Dark</span>
		</button>
		<button id="theme-system" onclick="electronAPI.setTheme('system')">
			<i data-lucide="monitor"></i>
			<span>System</span>
		</button>
	</div>
</section>
